\subsection{Cơ sở toán học và phương pháp tính toán thông số}
Toàn bộ các chỉ số đánh giá và dữ liệu vẽ đồ thị được lập trình dựa trên các công thức đại số tuyến tính và thống kê cốt lõi sau:
\begin{itemize}
    \item \textbf{Giá trị dự đoán ($\hat{y}$):} Được tính bằng phép nhân ma trận giữa ma trận thiết kế $X$ (đã bổ sung vector cột chứa toàn số $1$) và vector tham số $\theta$:
    \begin{equation}
        \hat{y} = X\theta = \theta_0 + \theta_1 x_1
    \end{equation}
    \textit{Trong đó:}
    \begin{itemize}
        \item $\hat{y}$: Tổng độ trễ dự đoán tới máy chủ đích (\texttt{rtt\_avg\_ms}), đơn vị là mili-giây (ms).
        \item $X$: Ma trận thiết kế đầu vào (chứa các giá trị $x_1$ và cột số $1$).
        \item $\theta_0$: Hệ số chặn (Intercept), là giá trị trễ dự đoán khi $x_1 = 0$, đơn vị là ms.
        \item $\theta_1$: Hệ số góc (Slope), thể hiện sự thay đổi của $\hat{y}$ khi $x_1$ tăng thêm 1 đơn vị.
        \item $x_1$: Đặc trưng đầu vào độ trễ gateway (\texttt{gateway\_rtt\_avg\_ms}), đơn vị là ms.
    \end{itemize}

    \item \textbf{Sai số toàn phương trung bình (MSE - Mean Squared Error):} Đo lường trung bình cộng của bình phương các khoảng cách từ điểm dữ liệu thực tế đến đường hồi quy dự đoán:
    \begin{equation}
        \text{MSE} = \frac{1}{m} \sum_{i=1}^{m} \left(y^{(i)} - \hat{y}^{(i)}\right)^2
    \end{equation}
    \textit{Trong đó:}
    \begin{itemize}
        \item $m$: Tổng số lượng mẫu (quan sát) có trong tập dữ liệu kiểm tra (Test set).
        \item $y^{(i)}$: Giá trị độ trễ thực tế của quan sát thứ $i$, đơn vị là ms.
        \item $\hat{y}^{(i)}$: Giá trị độ trễ do mô hình dự đoán tại quan sát thứ $i$, đơn vị là ms.
        \item $\sum_{i=1}^{m}$: Ký hiệu tổng cộng dồn từ quan sát đầu tiên ($i=1$) đến quan sát cuối cùng ($i=m$).
    \end{itemize}

    \item \textbf{Hệ số xác định ($R^2$ Score):} Đánh giá tỷ lệ phương sai của biến mục tiêu được giải thích bởi mô hình. Chỉ số này so sánh sai số của mô hình hiện tại với sai số giả định nếu chỉ dùng giá trị trung bình $\bar{y}$ để dự đoán:
    \begin{equation}
        R^2 = 1 - \frac{\sum_{i=1}^{m} \left(y^{(i)} - \hat{y}^{(i)}\right)^2}{\sum_{i=1}^{m} \left(y^{(i)} - \bar{y}\right)^2}
    \end{equation}
    \textit{Trong đó:}
    \begin{itemize}
        \item Tử số $\sum (y^{(i)} - \hat{y}^{(i)})^2$: Tổng bình phương phần dư (RSS), thể hiện mức độ sai số của mô hình.
        \item Mẫu số $\sum (y^{(i)} - \bar{y})^2$: Tổng bình phương toàn phần (TSS), thể hiện mức độ phân tán của dữ liệu gốc.
        \item $\bar{y}$: Giá trị độ trễ trung bình của toàn bộ các điểm thực tế trong tập kiểm tra, đơn vị là ms.
    \end{itemize}

    \item \textbf{Phần dư (Residuals):} Là sự chênh lệch trực tiếp giữa giá trị thực tế và giá trị dự đoán, được sử dụng làm tung độ cho hai biểu đồ phân tích phần dư:
    \begin{equation}
        e^{(i)} = y^{(i)} - \hat{y}^{(i)}
    \end{equation}
    \textit{Trong đó:}
    \begin{itemize}
        \item $e^{(i)}$: Mức độ sai lệch (phần dư) của riêng quan sát thứ $i$. Đơn vị là ms. Nếu $e^{(i)} > 0$, mô hình đang dự đoán thấp hơn thực tế; ngược lại nếu $e^{(i)} < 0$, mô hình đang dự đoán cao hơn thực tế.
    \end{itemize}
\end{itemize}
